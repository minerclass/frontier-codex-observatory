  "sources": {
    "terminal": {
      "label": "Vals AI · Terminal-Bench 4.0",
      "href": "https://www.vals-ai.com/benchmarks/terminal-bench-4",
      "updated": "October 13, 2026",
      "definition": "Terminal-Bench 4.0 score is the mean pass@1 percentage across three runs of 66 tasks using mini-swe-agent.",
      "caveat": "Published Terminal-Bench scores include provider fallback runs. Counting those as failures yields Opus 5.5 58.08%, Sonnet 5.5 62.63%, and Fable 5.1 50.00%. Effort settings are not fully exposed in the extracted leaderboard."
    },
    "finance": {
      "label": "Vals AI · Finance Agent v2",
      "href": "https://www.vals-ai.com/benchmarks/fabv2",
      "updated": "October 12, 2026",
      "definition": "Finance Agent v2 score is dealbreaker-gated, weighted partial credit on the held-out test set; it is not the percentage of entirely correct tasks.",
      "caveat": "The finance table was used directly. Some narrative takeaways on the page lag the current table. Three-run results use LLM grading."
    },
    "legal": {
      "label": "Vals AI · Harvey Legal Agent Benchmark",
      "href": "https://www.vals.ai/benchmarks/hlab",
      "updated": "October 12, 2026",
      "definition": "Harvey score averages two judge task pass rates; a task passes only when every criterion passes. The run uses the held-out set with internet disabled.",
      "caveat": "Vals Harvey results differ from Harvey LAB-AA v1.1 cited by Meta, which adds hallucination checks and uses a different judging setup."
    },
    "apps": {
      "label": "Vals AI · Vibe Code Bench v1.1",
      "href": "https://www.vals-ai.com/benchmarks/vibe-code",
      "updated": "October 12, 2026",
      "definition": "Vibe Code Bench v1.1 score averages workflow-test success. A test passes when at least 90% of its substeps succeed; it is not an entirely-working-app percentage.",
      "caveat": "App-building rows use OpenHands except Composer 2.5, which uses Cursor CLI. Its score measures a different model-plus-harness system. Small score differences have no extracted uncertainty bounds."
    }
  },
